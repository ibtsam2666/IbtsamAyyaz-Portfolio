{
  "name": "ibtsamayyaz-portfolio",
  "version": "1.0.0",
  "private": true,
  "description": "QA automation demos: Playwright UI and API suites, parallel CI, assertion mutation testing, an MCP rerun server and an AI test agent.",
  "license": "MIT",
  "author": "Ibtsam Ayyaz",
  "type": "commonjs",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --project=ui",
    "test:api": "playwright test --project=api",
    "test:smoke": "playwright test --grep @smoke",
    "report": "playwright show-report",
    "mutate": "tsx mutation-testing/mutate-assertions.ts",
    "mcp": "tsx mcp-rerun-server/server.ts",
    "agent": "tsx ai-test-agent/agent.ts",
    "build:portfolio-assets": "node scripts/build-portfolio-assets.mjs",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "0.32.1",
    "@modelcontextprotocol/sdk": "1.13.0",
    "@playwright/test": "1.55.0",
    "@types/node": "22.10.2",
    "tsx": "4.19.2",
    "typescript": "5.7.2",
    "zod": "3.25.76"
  },
  "allowScripts": {
    "esbuild@0.23.1": true
  }
}
