{
  "ci": {
    "collect": {
      "startServerCommand": "node scripts/serve.mjs 4180",
      "startServerReadyPattern": "Serving",
      "url": [
        "http://127.0.0.1:4180/",
        "http://127.0.0.1:4180/agent-lab.html",
        "http://127.0.0.1:4180/case-studies/cart-badge-agent.html",
        "http://127.0.0.1:4180/how-to-run.html"
      ],
      "numberOfRuns": 1,
      "settings": { "preset": "desktop", "chromeFlags": "--no-sandbox --headless=new" }
    },
    "assert": {
      "assertions": {
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "categories:best-practices": ["error", { "minScore": 0.9 }],
        "categories:seo": ["error", { "minScore": 0.9 }],
        "categories:performance": ["warn", { "minScore": 0.8 }]
      }
    },
    "upload": { "target": "filesystem", "outputDir": "lighthouse-report" }
  }
}
